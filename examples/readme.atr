struct Vec2:
    x: f64
    y: f64

enum Shape:
    Circle(f64)
    Rect(f64, f64)
    Point

impl Shape:
    fn area(&self) -> f64:
        match self:
            Circle(r) -> 3.141592653589793 * r * r
            Rect(w, h) -> w * h
            Point -> 0.0

fn main() -> i32:
    let name = "atrat"
    var total = 0.0
    let shapes = [Shape.Circle(1.0), Shape.Rect(2.0, 3.0), Shape.Point]
    for s in &shapes:
        total += s.area()
    print("{name}: total area = {total}")
    return 0
