# Algebraic data types + exhaustive pattern matching.

struct Vec2:
    x: f64
    y: f64

enum Shape:
    Circle(f64)
    Rect(f64, f64)
    Point

fn area(s: &Shape) -> f64:
    match s:
        Circle(r) -> 3.141592653589793 * r * r
        Rect(w, h) -> w * h
        Point -> 0.0

fn describe(s: &Shape) -> String:
    match s:
        Circle(r) -> "circle(r={r})"
        Rect(w, h) -> "rect({w}x{h})"
        Point -> "point"

fn main() -> i32:
    let shapes = [Shape.Circle(1.0), Shape.Rect(2.0, 3.0), Shape.Point]
    var total = 0.0
    for s in &shapes:
        total += area(s)
        print("{describe(s)} -> {area(s)}")
    print("total area = {total}")
    let v = Vec2 { x: 1.5, y: -2.0 }
    print(v)
    return 0
