# Parametric polymorphism, monomorphised to zero-cost C.

struct Node<T>:
    value: T
    children: List<Node<T>>

struct Counter:
    n: i64

impl Counter:
    fn bump(&mut self, by: i64) -> i64:
        self.n += by
        self.n

fn identity<T>(x: T) -> T:
    x

fn first_or<T>(xs: &List<T>, fallback: T) -> T:
    if xs.len() > 0:
        return xs[0]
    fallback

fn apply_twice<T>(f: fn(T) -> T, x: T) -> T:
    return f(f(x))

fn inc(x: i64) -> i64:
    x + 1

fn main() -> i32:
    var c = Counter { n: 0 }
    c.bump(2)
    c.bump(40)
    print("counter = {c.n}")

    let a: i64 = identity(41)
    let b: f64 = identity(1.5)
    print("a = {a}, b = {b}")

    let nums = [3, 1, 4, 1, 5]
    print("first = {first_or(&nums, -1)}")
    print("twice = {apply_twice(inc, 40)}")

    let kids = [Node { value: 2, children: [] }, Node { value: 3, children: [] }]
    let tree = Node { value: 1, children: kids }
    print("tree = {tree}")

    var stack = [1, 2, 3]
    stack.push(4)
    print("stack = {stack}, size = {stack.len()}")
    let top = stack.pop()
    print("popped = {top}")
    return 0
